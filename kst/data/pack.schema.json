{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "pack": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "standard_preamble": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "standard_preamble"
      ],
      "additionalProperties": true
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stratum": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "positive",
              "negative_control",
              "calibration"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "observed_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "expected_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "stratum",
          "kind",
          "prompt"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "pack",
    "probes"
  ],
  "additionalProperties": true
}
