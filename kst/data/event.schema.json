{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "run.started",
        "trial.started",
        "trial.finished",
        "run.finished",
        "score.recorded"
      ]
    },
    "payload": {
      "type": "object"
    },
    "previous_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "timestamp",
    "event_type",
    "payload",
    "previous_hash",
    "hash"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "plan": {
                "type": "object"
              },
              "pack_snapshot": {
                "type": "object",
                "properties": {
                  "schema_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pack": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "version": {
                        "type": "string",
                        "minLength": 1
                      },
                      "standard_preamble": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "version",
                      "standard_preamble"
                    ],
                    "additionalProperties": true
                  },
                  "probes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "stratum": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "positive",
                            "negative_control",
                            "calibration"
                          ]
                        },
                        "prompt": {
                          "type": "string",
                          "minLength": 1
                        },
                        "observed_date": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date"
                        },
                        "expected_signals": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "source_refs": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "stratum",
                        "kind",
                        "prompt"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "required": [
                  "pack",
                  "probes"
                ],
                "additionalProperties": true
              },
              "targets_snapshot": {
                "type": "object"
              }
            },
            "required": [
              "run_id",
              "plan",
              "pack_snapshot",
              "targets_snapshot"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "trial.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "trial_id": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "object"
              },
              "target_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pack": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "probe_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "probe_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "stratum": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "positive",
                      "negative_control",
                      "calibration"
                    ]
                  }
                },
                "required": [
                  "id",
                  "version",
                  "hash",
                  "probe_id",
                  "probe_hash",
                  "stratum",
                  "kind"
                ],
                "additionalProperties": true
              },
              "prompt": {
                "type": "object",
                "properties": {
                  "exact_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "exact_text",
                  "sha256"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "run_id",
              "trial_id",
              "target",
              "target_hash",
              "pack",
              "prompt"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "trial.finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "trial_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "completed",
                  "error",
                  "timeout",
                  "unsupported",
                  "cancelled"
                ]
              },
              "capture": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "raw_text": {
                        "type": "string"
                      },
                      "observed": {
                        "type": "object"
                      },
                      "isolation": {
                        "type": "object",
                        "properties": {
                          "session_fresh": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "clean_working_directory": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "web_enabled": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "tools_enabled": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "files_available": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "project_context_available": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "persistent_memory_enabled": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          },
                          "system_context_known": {
                            "enum": [
                              "true",
                              "false",
                              "unknown"
                            ]
                          }
                        },
                        "required": [],
                        "additionalProperties": true
                      },
                      "session_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "latency_ms": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0
                      },
                      "token_usage": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "output": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          }
                        },
                        "required": [],
                        "additionalProperties": true
                      },
                      "mode": {
                        "enum": [
                          "mock",
                          "manual",
                          "live"
                        ]
                      }
                    },
                    "required": [
                      "raw_text",
                      "observed",
                      "isolation",
                      "mode"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "cleanup_error": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "run_id",
              "trial_id",
              "status",
              "capture",
              "error",
              "cleanup_error"
            ],
            "additionalProperties": true,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "completed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "capture": {
                      "type": "object",
                      "properties": {
                        "raw_text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      }
                    },
                    "cleanup_error": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.finished"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "completed",
                  "incomplete",
                  "cancelled"
                ]
              },
              "trial_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "run_id",
              "status",
              "trial_count"
            ],
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "score.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "trial_id": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              },
              "scorer": {
                "type": "string",
                "minLength": 1
              },
              "rubric_version": {
                "type": "string",
                "minLength": 1
              },
              "assessment": {
                "enum": [
                  "recognized",
                  "partial",
                  "unknown",
                  "wrong",
                  "rejected",
                  "speculative",
                  "fabricated"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "trial_id",
              "score",
              "scorer",
              "rubric_version",
              "assessment",
              "note"
            ],
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
